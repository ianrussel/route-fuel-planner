# Django
SECRET_KEY=django-insecure-change-this-to-a-random-string-in-production
DEBUG=true
ALLOWED_HOSTS=*

# Routing - defaults to the free OSRM demo server (no key required)
# Swap for a self-hosted OSRM instance in production
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving
ROUTING_TIMEOUT=30

# Geocoding - free public endpoints, no key required
ARCGIS_GEOCODE_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Vehicle specs
VEHICLE_MPG=10.0
VEHICLE_TANK_RANGE_MILES=500.0
