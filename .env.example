# Django
SECRET_KEY=django-insecure-change-this-to-a-random-string-in-production
DEBUG=true
ALLOWED_HOSTS=*

# API authentication
# Set to any secret string to protect the API.
# Every request must then include the header: X-Api-Key: <your-key>
# Example: curl -H "X-Api-Key: <your-key>" "http://localhost:8000/api/route/?start=..."
# Leave blank to disable auth (local dev default).
API_KEY=

# Database
# Defaults to SQLite if unset. Swap the URL scheme to change engines:
#   SQLite:     sqlite:///db.sqlite3
#   PostgreSQL: postgres://user:password@localhost:5432/dbname
#   MySQL:      mysql://user:password@localhost:3306/dbname
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=0

# Routing - defaults to the free OSRM demo server (no key required)
# Swap for a self-hosted OSRM instance in production
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving
ROUTING_TIMEOUT=30

# Geocoding - free public endpoints, no key required
ARCGIS_GEOCODE_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Vehicle specs
VEHICLE_MPG=10.0
VEHICLE_TANK_RANGE_MILES=500.0
VEHICLE_MIN_FILL_GALLONS=10.0
